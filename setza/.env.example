# Required for local Django development
DEBUG=1
SECRET_KEY=change-me
ALLOWED_HOSTS=127.0.0.1,localhost

# Setza demo defaults
SETZA_DEFAULT_ROLE=creator

# Keep background jobs in-process for local development.
CELERY_TASK_ALWAYS_EAGER=1

# Optional: use PostgreSQL instead of SQLite.
# Leave these commented unless you are running Postgres locally.
# POSTGRES_DB=setza
# POSTGRES_USER=setza
# POSTGRES_PASSWORD=change-me
# POSTGRES_HOST=127.0.0.1
# POSTGRES_PORT=5432

# Optional: use Redis-backed Celery workers.
# Only needed when CELERY_TASK_ALWAYS_EAGER=0.
# CELERY_BROKER_URL=redis://127.0.0.1:6379/0
# CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0

# Optional: local GitHub Pages export prefix.
# GitHub Actions sets this automatically to the repository name.
# GITHUB_PAGES_BASE_PATH=setza
